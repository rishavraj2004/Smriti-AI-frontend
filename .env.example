# Smriti AI Backend API URL
# For Web / Localhost: http://localhost:3000
# For Android Emulator: http://10.0.2.2:3000
# For Expo Go on Physical Phone: Use your PC's Wi-Fi IP e.g. http://192.168.1.9:3000
EXPO_PUBLIC_API_URL=http://192.168.1.9:3000

# Optional backend TTS voice synthesis flag
EXPO_PUBLIC_ENABLE_BACKEND_TTS=true
